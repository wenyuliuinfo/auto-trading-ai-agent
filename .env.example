# --- Domain Postgres ---
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_USER="your_user_name"
POSTGRES_PASSWORD="your_password"
POSTGRES_DB="your_db_name"
# Required. This is the only database connection source for the domain DB.
POSTGRES_DATABASE_URL="postgresql+asyncpg://your_user_name:your_password@localhost:5432/your_db_name"
DATABASE_POOL_SIZE=20
DATABASE_POOL_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=60

# --- Backend (FastAPI)
# Server-side URL used by Next.js server components and API rewrites.
# In Docker this is the internal `fastapi` service name; keep localhost
# for local `pnpm dev`.
API_BASE_URL="http://localhost:8000"
STUB_AGENTS="false"   # true = deterministic local stubs, no external API calls
KLINE_ENABLED=true
KLINE_NODE_BIN=node
KLINE_SCRIPT_PATH=/app/tools/stock-sdk-kline/fetch_klines.mjs
KLINE_TIMEOUT_S=60

# --- Langfuse (self-hosted tracing) ---
LANGFUSE_DB_PASSWORD="change_me"
LANGFUSE_NEXTAUTH_SECRET="change_me_random_string"
LANGFUSE_SALT="change_me_random_string"
# Public origin used for Langfuse's browser UI/auth (for cloud, set this to
# the reachable Langfuse URL, e.g. http://YOUR_SERVER_IP:3001).
LANGFUSE_NEXTAUTH_URL="http://localhost:3001"

# --- LLM Providers ---
DEEPSEEK_API_KEY="your_key_here"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# --- Vector store (local container) ---
PINECONE_API_KEY="your_key_here"
PINECONE_HOST_URL="http://localhost:5080"
PINECONE_INDEX_NAME="vector_store"

# --- Free-tier data vendors ---
FMP_API_KEY="your_key_here"
FINNHUB_API_KEY="your_key_here"
SERP_API_KEY="your_key_here"
